# Copy to .env.local for a local build. Never commit a real value.
# Everything here is optional: with nothing set the app sends no telemetry.

# Crash reporting. Any server that speaks the Sentry protocol (Sentry, GlitchTip).
SENTRY_DSN=

# Traces and usage events. Base URL of an OTLP/HTTP receiver, e.g. https://collector.example.com:4318
OTLP_ENDPOINT=

# Source map upload during native builds. Leave empty to skip the upload step.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_URL=
# SENTRY_AUTH_TOKEN belongs in a password manager or a CI secret, never here.
