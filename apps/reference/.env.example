# Copy to .env.local for a local build. Never commit a real value.
# Everything here is optional. With nothing set the build is the public
# flavor, version 0.0.0, with placeholder identifiers and no telemetry.

# Which flavor to build: public or corporate.
APP_VARIANT=

# Set by the release workflow to the release tag (vMAJOR.MINOR.PATCH).
# Leave empty for a preview build. Never set by hand for a store build.
APP_VERSION=

# Bundle identifier and Android application id, per flavor.
APP_ID_PUBLIC=
APP_ID_CORPORATE=

# API base URL, per flavor. Empty uses the in-memory demo API.
API_BASE_URL_PUBLIC=
API_BASE_URL_CORPORATE=

# Crash reporting, per flavor. Any server that speaks the Sentry protocol.
SENTRY_DSN_PUBLIC=
SENTRY_DSN_CORPORATE=

# Traces and usage events, per flavor. Base URL of an OTLP/HTTP receiver.
OTLP_ENDPOINT_PUBLIC=
OTLP_ENDPOINT_CORPORATE=

# Source map upload during native builds. Leave empty to skip the upload step.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_URL=
# SENTRY_AUTH_TOKEN belongs in a password manager or a CI secret, never here.
